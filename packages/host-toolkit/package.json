{
  "name": "@manehorizons/cadence-host-toolkit",
  "version": "1.53.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Shared toolkit for CADENCE host adapters — the hook-event routing algorithm and the slash-command catalog used by host-claude-code and host-codex.",
  "license": "MIT",
  "author": "Thomas Powers",
  "homepage": "https://github.com/manehorizons/cadence#readme",
  "bugs": "https://github.com/manehorizons/cadence/issues",
  "keywords": [
    "cadence",
    "host-adapter",
    "toolkit",
    "hooks",
    "slash-commands"
  ],
  "type": "module",
  "main": "./dist/routing.js",
  "types": "./dist/routing.d.ts",
  "exports": {
    ".": {
      "import": "./dist/routing.js",
      "types": "./dist/routing.d.ts"
    },
    "./locate-self": {
      "import": "./dist/locate-self.js",
      "types": "./dist/locate-self.d.ts"
    },
    "./install-merge": {
      "import": "./dist/install-merge.js",
      "types": "./dist/install-merge.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manehorizons/cadence.git",
    "directory": "packages/host-toolkit"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@manehorizons/cadence-types": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
