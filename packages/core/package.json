    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@cadence/types": "workspace:*",
    "commander": "^13.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cadence/testkit": "workspace:*",
    "vitest": "^2.1.0"
  }
}
