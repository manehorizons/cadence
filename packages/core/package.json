{
  "name": "@cadence/core",
  "version": "0.2.0-rc.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" }
  },
  "bin": { "cadence": "./bin/cadence.cjs" },
  "files": ["dist", "bin"],
  "scripts": {
