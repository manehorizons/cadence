{
  "name": "@cadence/core",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" }
  },
  "bin": { "cadence": "./bin/cadence.cjs" },
  "files": ["dist", "bin"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manehorizons/cadence.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@cadence/types": "workspace:*",
    "commander": "^13.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cadence/testkit": "workspace:*",
    "vitest": "^2.1.0"
  }
}
