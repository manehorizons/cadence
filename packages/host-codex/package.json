{
  "name": "@thomas-powers-jr/cadence-host-codex",
  "version": "1.59.0",
  "engines": {
    "node": ">=22"
  },
  "description": "OpenAI Codex CLI adapter for CADENCE — installs lifecycle hooks and slash commands that drive the CADENCE engine from inside Codex.",
  "license": "MIT",
  "author": "Thomas Powers",
  "homepage": "https://thomas-powers-jr.github.io/cadence/",
  "bugs": "https://github.com/thomas-powers-jr/cadence/issues",
  "keywords": [
    "cadence",
    "codex",
    "openai-codex",
    "ai",
    "agents",
    "hooks",
    "slash-commands"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "cadence-host-codex": "./bin/cadence-host-codex.cjs"
  },
  "files": [
    "dist",
    "bin",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomas-powers-jr/cadence.git",
    "directory": "packages/host-codex"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@thomas-powers-jr/cadence-core": "workspace:*",
    "@thomas-powers-jr/cadence-host-toolkit": "workspace:*",
    "@thomas-powers-jr/cadence-types": "workspace:*",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@thomas-powers-jr/cadence-testkit": "workspace:*",
    "vitest": "^4.1.10"
  }
}
