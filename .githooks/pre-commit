#!/usr/bin/env bash
# CADENCE doc-sync gate (commit-time).
#
# When a commit changes the canonical version (packages/core/package.json),
# CLAUDE.md must mention the new version — otherwise the release narrative goes
# stale (it once sat at 1.6.0 while npm was at 1.10.0). Fires only on the
# version-bump commit; ordinary commits exit instantly. Bypass: git commit
# --no-verify. The shared checker is .githooks/check-doc-sync.sh.
set -euo pipefail

hook_dir="$(dirname "$0")"
pkg="packages/core/package.json"

# First occurrence of `"version": "X.Y.Z"` → X.Y.Z, from a given git object.
ver_from() {
  git show "$1" 2>/dev/null \
    | grep -m1 -oE '"version"[[:space:]]*:[[:space:]]*"[^"]+"' \
    | grep -oE '[0-9][^"[:space:]]*' || true
}

staged_ver="$(ver_from ":${pkg}")"        # index (what will be committed)
head_ver="$(ver_from "HEAD:${pkg}")"      # last commit

# No staged version, or unchanged → nothing to enforce.
if [ -z "$staged_ver" ] || [ "$staged_ver" = "$head_ver" ]; then
  exit 0
fi

echo "pre-commit: core version ${head_ver:-∅} → ${staged_ver}; checking CLAUDE.md is in sync…"
if ! git show ":CLAUDE.md" | "${hook_dir}/check-doc-sync.sh" "$staged_ver" "CLAUDE.md"; then
  exit 1
fi
echo "pre-commit: CLAUDE.md mentions ${staged_ver} — doc-sync OK."
exit 0
